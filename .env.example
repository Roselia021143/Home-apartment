# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env.local)

# API key จาก https://resend.com/api-keys — ถ้าเว้นว่าง ข้อมูลฟอร์มจะแสดงใน console แทนการส่งอีเมล
RESEND_API_KEY=

# อีเมลเจ้าของหอที่จะรับคำขอจอง
OWNER_EMAIL=

# (ไม่บังคับ) อีเมลผู้ส่ง ต้องเป็นโดเมนที่ยืนยันกับ Resend แล้ว
# ถ้าเว้นว่างจะใช้ onboarding@resend.dev ซึ่งส่งได้เฉพาะอีเมลที่ใช้สมัคร Resend เท่านั้น
BOOKING_FROM_EMAIL=
